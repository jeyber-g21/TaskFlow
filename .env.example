# ---------------------------------------------------------------------------
# Copia este archivo como `.env.local` y rellena los valores.
# `.env.local` NUNCA se sube a git.
# ---------------------------------------------------------------------------

# --- Cliente (se exponen al navegador) -------------------------------------
# Supabase → Project Settings → API Keys

# URL pública del proyecto de Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable: segura en el cliente porque las políticas RLS la limitan
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Solo servidor (nunca con prefijo NEXT_PUBLIC_) ------------------------

# Clave secreta: salta las políticas RLS. Solo para tareas administrativas,
# como limpiar usuarios de prueba. Nunca la uses en código que llegue al
# navegador.
SUPABASE_SECRET_KEY=

# --- Base de datos ---------------------------------------------------------
# Supabase → Connect → ORM / Direct connection.
# Sustituye [YOUR-PASSWORD] por la contraseña de la base de datos.

# Pooler en modo transacción (puerto 6543): la que usaría la aplicación en
# producción, porque cada función serverless abre y cierra conexiones.
DATABASE_URL=

# Pooler en modo sesión (puerto 5432): la que usa drizzle-kit para migrar.
# El modo transacción no admite bien las sentencias DDL.
DIRECT_URL=

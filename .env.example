# ---------------------------------------------------------------------------
# Copia este archivo como `.env.local` y rellena los valores.
# `.env.local` NUNCA se sube a git.
# Los valores se obtienen en: Supabase → Project Settings → API / Database
# ---------------------------------------------------------------------------

# URL pública del proyecto de Supabase (se expone al navegador)
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable: segura en el cliente porque las políticas RLS la limitan
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta: SOLO servidor. Salta las políticas RLS, nunca la expongas
# al cliente ni la prefijes con NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Cadena de conexión a Postgres usada por Drizzle (migraciones y queries)
# Formato: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=
